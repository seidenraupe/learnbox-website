# KreativMedia / Plesk – nur lokal, nicht committen (.env kopieren und Werte eintragen)
# Verbindungstest: python3 scripts/test-kreativmedia-connection.py

# Aus Plesk: FTP-Benutzer der Domain learnbox.ch (Hostname, nicht IP – sonst TLS-Fehler)
KREATIVMEDIA_SFTP_HOST=ftp.example.kreativmedia.ch
KREATIVMEDIA_SFTP_PORT=21
KREATIVMEDIA_SFTP_USER=
KREATIVMEDIA_SFTP_PASSWORD=

# Meist bereits das Webroot des FTP-Users (bei learnbox: "/")
KREATIVMEDIA_REMOTE_PATH=/

# ftps | sftp | auto (Plesk Shared: in der Regel ftps auf Port 21)
KREATIVMEDIA_PROTOCOL=ftps

# Optional: GitHub Actions (gleiche Werte wie oben)
# FTP_SERVER=
# FTP_USERNAME=
# FTP_PASSWORD=
# FTP_REMOTE_DIR=/