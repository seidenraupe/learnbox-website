RewriteEngine On

# HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Alte Wix-Pfade
RewriteRule ^dienstleistungen/?$ /leistungen.html [R=301,L]
RewriteRule ^learnblog/?$ /blog.html [R=301,L]
RewriteRule ^learnblog/categories/digitalisierung/?$ /blog.html [R=301,L]
RewriteRule ^post/schwarm-intelligenz-f[^/]+rdern/?$ /blog/schwarm-intelligenz-foerdern.html [R=301,L,NC]
RewriteRule ^post/revolution-in-der-weiterbildung/?$ /blog/revolution-in-der-weiterbildung.html [R=301,L]
RewriteRule ^post/schwarm-intelligenz-dank-vernetzung-bringt-erfolg/?$ /blog/schwarm-intelligenz-dank-vernetzung.html [R=301,L]
RewriteRule ^post/digitalisierung-nicht-verschlafen-das-richtige-lms-finden/?$ /blog/digitalisierung-nicht-verschlafen.html [R=301,L]
RewriteRule ^post/internes-wissen-gezielt-f[^/]+rdern/?$ /blog/internes-wissen-gezielt-foerdern.html [R=301,L,NC]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
</IfModule>
